@prefix hg2: <https://linkeddata.cultureelerfgoed.nl/def/hg2/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

hg2:IdentityHypothesisShape a sh:NodeShape ; sh:targetClass hg2:IdentityHypothesis ;
 sh:property [ sh:path hg2:hasCandidateReference ; sh:minCount 2 ; sh:class hg2:PlaceReference ] ;
 sh:property [ sh:path hg2:identityRationale ; sh:minCount 1 ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ] ;
 sh:property [ sh:path hg2:hypothesisStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

hg2:HistoricalRelationEvidenceShape a sh:NodeShape ; sh:targetClass hg2:HistoricalRelation ;
 sh:property [ sh:path hg2:relationEvidence ; sh:minCount 1 ; sh:class hg2:PlaceAssertion ] .

hg2:InterpretedStateEvidenceShape a sh:NodeShape ; sh:targetClass hg2:PlaceState ;
 sh:property [ sh:path hg2:interpretationOf ; sh:minCount 1 ; sh:class hg2:PlaceAssertion ] .
